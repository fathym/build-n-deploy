{
  // The deploy.yml census (card T19-CC-BND-V4). This repo has no CI of its own,
  // so run it before tagging a new version.
  "tasks": {
    "test": "deno test --allow-read tests/deployWorkflow.tests.ts",
    "check": "deno fmt --check tests && deno lint tests && deno check tests/deployWorkflow.tests.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/yaml": "jsr:@std/yaml@1.3.0"
  }
}
